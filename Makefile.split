# --------------------------------------
# General Rules
# --------------------------------------

# obtain a list of segments from the *.c files in bin directory
SEGMENTS := \
    $(notdir $(basename $(wildcard bin/*.c))) \
    $(addprefix $(VERSION)/,$(notdir $(basename $(wildcard bin/$(VERSION)/*.c)))) \
    $(addsuffix _skybox,$(notdir $(basename $(wildcard textures/skyboxes/*.png))))

# Directories containing PNG files
TEXTURE_DIRS := \
    $(wildcard textures/*/) \
    $(filter %/,$(wildcard actors/*/))

# NOTE: textures assume naming convention "texture.<encoding>.png" generates "texture.<encoding>"

ACTOR_GROUPS := \
    group_global  \
    group_btcm \
    group_vanilla

MENU_SEG7 := data/scenes/menu/seg7

SEG_FILES := \
    $(SEGMENTS:%=$(BUILD_DIR)/bin/%.elf) \
    $(ACTOR_GROUPS:%=$(BUILD_DIR)/actors/%.elf) \
    $(BUILD_DIR)/$(MENU_SEG7).elf

YAY0_FILES := \
    $(SEGMENTS:%=$(BUILD_DIR)/bin/%.szp) \
    $(ACTOR_GROUPS:%=$(BUILD_DIR)/actors/%.szp) \
    $(BUILD_DIR)/$(MENU_SEG7).szp

YAY0_OBJ_FILES := $(YAY0_FILES:.szp=.szp.o)


# --------------------------------------
# Actor Rules
# --------------------------------------

# Wait for all actor textures before building groups (HackerSM64 #941).
# Only the groups MB64 actually builds are listed here.
ACTOR_TEXTURES := $(wildcard actors/*/*.png)
ACTOR_TEXTURES_INC_C := $(ACTOR_TEXTURES:%.png=$(BUILD_DIR)/%.inc.c)

# Actor dependencies
$(BUILD_DIR)/actors/group_global.o:  | $(ACTOR_TEXTURES_INC_C)
$(BUILD_DIR)/actors/group_btcm.o: | $(ACTOR_TEXTURES_INC_C)
$(BUILD_DIR)/actors/group_vanilla.o: | $(ACTOR_TEXTURES_INC_C)

# Actor Elf Files
$(BUILD_DIR)/actors/group_global.elf:  SEGMENT_ADDRESS := 0x04000000
$(BUILD_DIR)/actors/group_btcm.elf: SEGMENT_ADDRESS := 0x06000000
$(BUILD_DIR)/actors/group_vanilla.elf: SEGMENT_ADDRESS := 0x06000000

# --------------------------------------
# Menu Segment 7 Rules
# --------------------------------------

$(BUILD_DIR)/$(MENU_SEG7).elf: SEGMENT_ADDRESS := 0x07000000

# --------------------------------------
# Texture Bin Rules
# --------------------------------------

# Others
SEGMENT2_TEXTURES               := $(wildcard $(TEXTURE_DIR)/segment2/*.png)
EFFECT_TEXTURES                 := $(wildcard $(TEXTURE_DIR)/effect/*.png)
MB64_BUTTON_TEXTURES            := $(wildcard $(TEXTURE_DIR)/mb64_buttons/*.png)
MB64_LEVEL_TEXTURES             := $(wildcard $(TEXTURE_DIR)/mb64_textures/*.png)

# Texture Files
$(BUILD_DIR)/bin/segment2.o:        $(SEGMENT2_TEXTURES:%.png=$(BUILD_DIR)/%.inc.c)
$(BUILD_DIR)/bin/effect.o:          $(EFFECT_TEXTURES:%.png=$(BUILD_DIR)/%.inc.c)
$(BUILD_DIR)/bin/mb64_buttons.o:    $(MB64_BUTTON_TEXTURES:%.png=$(BUILD_DIR)/%.inc.c)
$(BUILD_DIR)/bin/mb64_textures.o:   $(MB64_LEVEL_TEXTURES:%.png=$(BUILD_DIR)/%.inc.c)

# Others
$(BUILD_DIR)/bin/segment2.elf:           SEGMENT_ADDRESS := 0x02000000
$(BUILD_DIR)/bin/mb64_buttons.elf:       SEGMENT_ADDRESS := 0x03000000
$(BUILD_DIR)/bin/mb64_textures.elf:      SEGMENT_ADDRESS := 0x05000000
$(BUILD_DIR)/bin/effect.elf:             SEGMENT_ADDRESS := 0x0B000000
# EU segment 19 translations
$(BUILD_DIR)/bin/eu/translation_de.elf:  SEGMENT_ADDRESS := 0x19000000
$(BUILD_DIR)/bin/eu/translation_en.elf:  SEGMENT_ADDRESS := 0x19000000
$(BUILD_DIR)/bin/eu/translation_fr.elf:  SEGMENT_ADDRESS := 0x19000000

# --------------------------------------
# Skybox Rules
# --------------------------------------

$(BUILD_DIR)/bin/%_skybox.c: textures/skyboxes/%.png
	$(call print,Splitting:,$<,$@)
	$(V)$(SKYCONV) --type sky --split $^ $(BUILD_DIR)/bin

$(BUILD_DIR)/bin/%_skybox.elf: SEGMENT_ADDRESS := 0x0A000000

# --------------------------------------
# Misc Rules
# --------------------------------------

# ipl3 textures are not compressed
IPL3_TEXTURE_FILES          := $(wildcard $(TEXTURE_DIR)/ipl3_raw/*.png)
IPL3_RAW_FILES              := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%,$(IPL3_TEXTURE_FILES)))

CRASH_TEXTURE_FILES         := $(wildcard $(TEXTURE_DIR)/crash_custom/*.png)
CRASH_TEXTURE_C_FILES       := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%.inc.c,$(CRASH_TEXTURE_FILES)))

FASTTEXT_TEXTURE_FILES      := $(wildcard $(TEXTURE_DIR)/fasttext/*.png)
FASTTEXT_TEXTURE_C_FILES    := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%.inc.c,$(FASTTEXT_TEXTURE_FILES)))
